---
import BottomNav from "@components/features/layout/bottombar/bottomNav.astro";
import NavSidebar from "@components/features/layout/sidebar/navSidebar.astro";
import TopBar from "@components/features/layout/topbar/topBar.astro";
import { cn } from "cn";

interface Props {
  class?: string
}

const { class: className } = Astro.props;
---

<div class="fixed inset-0 flex flex-row min-w-0">
  <NavSidebar class="hidden md:flex" />

  <div class="flex flex-1 flex-col min-h-0 min-w-0">
    <TopBar />

    <main class={cn("flex-1 min-h-0 overflow-y-auto", className)}>
      <slot />
    </main>

    <BottomNav class="flex md:hidden shrink-0" />
  </div>
</div>
