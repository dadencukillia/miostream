---
import BottomNav from "@components/features/layout/bottombar/bottomNav.astro";
import NavSidebar from "@components/features/layout/sidebar/navSidebar.astro";
import TopBar from "@components/features/layout/topbar/topBar.astro";
import { cn } from "cn";

interface Props {
  class?: string
}

const { class: className } = Astro.props;
---

<div class="flex w-screen">
  <NavSidebar class="hidden md:flex" />

  <div class="flex flex-1 flex-col h-screen">
    <TopBar />

    <main class={cn("flex-1 overflow-y-auto", className)}>
      <slot />
    </main>

    <BottomNav class="flex md:hidden" />
  </div>
</div>
