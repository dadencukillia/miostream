---
import type { HTMLAttributes } from 'astro/types';
import { cn } from 'cn';
import FireIcon from "~icons/hugeicons/fire-03";
import ListIcon from "~icons/hugeicons/left-to-right-list-bullet";
import ClapperboardIcon from "~icons/hugeicons/left-to-right-list-triangle";
import TimeQuarterPassIcon from "~icons/hugeicons/time-quarter-pass";
import HeartIcon from "~icons/hugeicons/favourite";

interface Props extends HTMLAttributes<"div"> {
  socialNetworks: Record<string, string>
}

const {
  socialNetworks,
  class: className,
  ...divAttributes
} = Astro.props;
---

<div class={cn("flex flex-col gap-2 bg-background border border-border rounded-xl p-2", className)} {...divAttributes}>
  <div class="flex flex-wrap gap-3 items-between">
    <div class="flex flex-1 flex-col gap-2 items-center justify-center aspect-square border-border rounded-sm p-3 pt-5 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-accent">
      <ListIcon className="size-12" />
      <span class="text-sm text-center leading-none">366</span>
    </div>

    <div class="flex flex-1 flex-col gap-2 items-center justify-center aspect-square border-border rounded-sm p-3 pt-5 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-accent">
      <ClapperboardIcon className="size-12" />
      <span class="text-sm text-center leading-none">3,660</span>
    </div>

    <div class="flex flex-1 flex-col gap-2 items-center justify-center aspect-square border-border rounded-sm p-3 pt-5 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-accent">
      <FireIcon className="size-12 text-red-600" />
      <span class="text-sm text-center leading-none">1,000</span>
    </div>

    <div class="flex flex-1 flex-col gap-2 items-center justify-center aspect-square border-border rounded-sm p-3 pt-5 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-accent">
      <TimeQuarterPassIcon className="size-12" />
      <span class="text-sm text-center leading-none">63 дні</span>
    </div>

    <div class="flex flex-1 flex-col gap-2 items-center justify-center aspect-square border-border rounded-sm p-3 pt-5 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-accent">
      <HeartIcon className="size-12" />
      <span class="text-sm text-center leading-none">5</span>
    </div>
  </div>
</div>
