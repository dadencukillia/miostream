---
import ProfileAvatar from "@components/features/profile/profileAvatar";
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

interface Props extends HTMLAttributes<"div"> {
  name: string,
  nickname: string,
  bio: string,
  avatarUrl: string,
  frameUrl: string,
}

const {
  name, nickname, bio, avatarUrl, frameUrl,
  class: className,
  ...divAttributes
} = Astro.props;
---

<div class={cn("flex gap-8 bg-background border border-border rounded-xl p-5", className)} {...divAttributes}>
  <div 
     class="w-fit h-fit avatar-frame"
     style={`--frame-url:url(${frameUrl})`}
   >
    <ProfileAvatar
      client:load
      imageUrl={ avatarUrl }
      username={ nickname }
      className="w-20 h-20 rounded-sm after:rounded-sm"
      classImg="rounded-sm"
      classFallback="rounded-sm text-2xl"
    />
  </div>

  <div class="flex flex-col pt-1">
    <h1 class="font-display text-lg font-bold leading-none">{ name }</h1>
    <p class="text-sm pt-1">@{ nickname }</p>
    <p class="text-sm text-muted-foreground pt-2">{ bio }</p>
  </div>
</div>
