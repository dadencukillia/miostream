---
import type { HTMLAttributes } from 'astro/types';
import { Badge } from "@ui/badge";

// Config

interface AnimeStatusConfig {
  label: string,
  color: string
};

export const animeStatuses = {
  upcoming: {
    label: "Анонсовано",
    color: "#1d4ed8",
  } as AnimeStatusConfig,
  ongoing: {
    label: "Онґоїнґ",
    color: "#15803d",
  } as AnimeStatusConfig,
  cancelled: {
    label: "Скасовано",
    color: "#b91c1c",
  } as AnimeStatusConfig,
  finished: {
    label: "Завершено",
    color: "#475530",
  } as AnimeStatusConfig,
} as const;

// Props

interface Props extends HTMLAttributes<"span"> {
  animeStatus: keyof typeof animeStatuses 
};

const { animeStatus, class: className, ...spanAttrs } = Astro.props;

// Values

const statusValues = animeStatuses[animeStatus];
---

<Badge
  variant="secondary"
  style={{ backgroundColor: statusValues.color }}
  className={ className }
  { ...spanAttrs }
>
  { statusValues.label }
</Badge>
