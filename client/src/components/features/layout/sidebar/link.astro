---
import type { HTMLAttributes } from 'astro/types';
import { buttonVariants } from "@ui/button";
import { cn } from 'cn';

interface Props extends HTMLAttributes<"a"> {
  icon: (_props: Record<string, any>) => any;
  title: string;
  link: string;
  activeRegex: RegExp;
}

const { 
  class: className, 
  icon: Icon,
  title, 
  link, 
  activeRegex, 
  ...anchorProps 
} = Astro.props;

const isActive = activeRegex.test(Astro.url.pathname.replace(/\/$/, "") || "/");
---

<a
  href={ link } 
  aria-current={ isActive ? "page" : undefined } 
  class={cn(
    buttonVariants({ variant: isActive ? "default" : "ghost", size: "lg" }),
    "justify-start",
    isActive ? "font-bold" : "", className
  )}
  { ...anchorProps }
>
  <Icon className="size-5" />
  <span>{ title }</span>
</a>
