---
import TvIcon from "~icons/hugeicons/tv-01";
import HomeIcon from "~icons/hugeicons/home-05";
import MagicWandIcon from "~icons/hugeicons/magic-wand-02";
import ListVideoIcon from "~icons/hugeicons/list-video";
import UserIcon from "~icons/hugeicons/user-02";
import SidebarLink from "./link.astro";
import * as config from "@lib/config";
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

type Props = HTMLAttributes<"div">;

const { class: className } = Astro.props;

interface Link {
  icon: (_props: Record<string, any>) => any;
  title: string;
  link: string;
  activeRegex: RegExp;
}

const links: Link[] = [
  {
    icon: HomeIcon,
    title: "Головна",
    link: "/",
    activeRegex: /^\/$/g
  },
  {
    icon: MagicWandIcon,
    title: "Досліджуй",
    link: "/discover",
    activeRegex: /^\/discover/g
  },
  {
    icon: ListVideoIcon,
    title: "Мій список",
    link: "/list",
    activeRegex: /^\/list/g
  },
  {
    icon: UserIcon,
    title: "Профіль",
    link: "/profile",
    activeRegex: /^\/profile/g
  },
];
---

<aside class={cn("flex w-64 flex-col border-r border-sidebar-border bg-sidebar px-4 py-7 transition-transform lg:translate-x-0", className)}>
  <a href="/">
    <div class="flex items-center gap-3 px-2">
      <div class="flex size-9 items-center justify-center rounded-xl bg-primary text-primary-foreground">
        <TvIcon class="size-5" />
      </div>
      <span class="text-xl text-foreground font-bold tracking-tight">{ config.APP_NAME }</span>
    </div>
  </a>

  <nav class="mt-12 flex flex-col gap-2">
    { links.map(el => (
      <SidebarLink 
        icon={ el.icon }
        title={ el.title }
        link={ el.link }
        activeRegex={ el.activeRegex }
      />
    )) }
  </nav>
</aside>
