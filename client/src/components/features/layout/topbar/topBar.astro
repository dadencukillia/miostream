---
import { Button } from "@ui/button";
import SearchIcon from "~icons/hugeicons/search-02";
import BellIcon from "~icons/hugeicons/notification-01";
import ProfileAvatar from "@components/features/profile/profileAvatar";
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

type Props = HTMLAttributes<"div">;

const { class: className } = Astro.props;
---

<header class={cn("flex gap-3 h-20 items-center justify-between border-b border-border bg-background text-popover-foreground px-container backdrop-blur-xl", className)}>
  <div class="flex flex-1 max-w-md items-center gap-2 rounded-xl border border-border bg-secondary pl-3">
    <SearchIcon className="size-[18px] text-muted-foreground" />
    <input class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground pl-1 pr-3 py-2.5" placeholder="Пошук аніме..." />
  </div>
  <div class="ml-auto flex items-center gap-1">
    <Button variant="ghost" size="icon-lg">
      <BellIcon className="size-5" />
    </Button>
    <a href="/profile" class="hidden md:flex">
      <ProfileAvatar client:load imageUrl="" username="dadencukillia" />
    </a>
  </div>
</header>
