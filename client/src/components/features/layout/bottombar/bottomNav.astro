---
import HomeIcon from "~icons/hugeicons/home-05";
import MagicWandIcon from "~icons/hugeicons/magic-wand-02";
import ListVideoIcon from "~icons/hugeicons/list-video";
import UserIcon from "~icons/hugeicons/user-02";
import BottombarLink from "./link.astro";
import type { HTMLAttributes } from 'astro/types';
import { cn } from 'cn';

type Props = HTMLAttributes<"div">;

const { class: className } = Astro.props;

interface Link {
  icon: (_props: Record<string, any>) => any;
  title: string;
  link: string;
  activeRegex: RegExp;
}

const links: Link[] = [
  {
    icon: HomeIcon,
    title: "Головна",
    link: "/",
    activeRegex: /^\/$/g
  },
  {
    icon: MagicWandIcon,
    title: "Досліджуй",
    link: "/discover",
    activeRegex: /^\/discover/g
  },
  {
    icon: ListVideoIcon,
    title: "Список",
    link: "/list",
    activeRegex: /^\/list/g
  },
  {
    icon: UserIcon,
    title: "Профіль",
    link: "/profile",
    activeRegex: /^\/profile/g
  },
];
---

<nav class={cn("flex gap-6 h-15 items-center justify-center border-b border-border bg-popover text-popover-foreground px-container backdrop-blur-xl", className)}>
  { links.map(el => (
    <BottombarLink 
      icon={ el.icon }
      title={ el.title }
      link={ el.link }
      activeRegex={ el.activeRegex }
    />
  )) }
</nav>
